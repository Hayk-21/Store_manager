# Copy to .env and fill in. On Railway these go in the service's Variables tab.

# --- database (Neon) ---------------------------------------------------------
# The POOLED connection string (host contains "-pooler"). Used by the app.
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/storemanager?sslmode=require
# The DIRECT connection string (no "-pooler"). Used by migrate.py, because DDL
# through a transaction-mode pooler is unreliable. Strongly recommended.
DIRECT_DATABASE_URL=postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/storemanager?sslmode=require

# --- secrets -----------------------------------------------------------------
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# Must be the IDENTICAL string in the bot service.
BOT_SHARED_SECRET=

# --- telegram login ----------------------------------------------------------
# The SAME token the bot service uses. The web service needs it to send login
# codes itself; without it codes are only written to the log (local dev only).
TELEGRAM_BOT_TOKEN=
# The bot's @name, used to build "open the bot and press Start" links.
BOT_USERNAME=store_manager_arm_bot
LOGIN_CODE_TTL_MINUTES=10
LOGIN_CODES_PER_HOUR=6
MAX_CODE_ATTEMPTS=5

# --- app ---------------------------------------------------------------------
APP_TIMEZONE=Asia/Yerevan
# The public URL of this service, WITH the scheme. Used for the cross-origin
# CSRF check, so a wrong value here rejects every form post including login.
# (A missing scheme is repaired automatically, but write it out anyway.)
APP_BASE_URL=http://localhost:8000
# Leave unset. "0.0.0.0" is what Railway's healthcheck can reach. Set to "::"
# only if you need the bot to reach this service over Railway's private
# network, and confirm the healthcheck still passes afterwards.
# BIND_HOST=0.0.0.0
APP_CURRENCY=֏
# Set to 1 only for local http development; cookies are Secure otherwise.
APP_INSECURE_COOKIES=0
LOG_LEVEL=INFO

# --- tuning (all optional, defaults shown) -----------------------------------
# Opened eagerly at startup, so a handshake with Neon never happens inside
# somebody's page load. Ten is well inside one service's pooled budget.
DB_POOL_MIN=5
DB_POOL_MAX=10
SESSION_TTL_DAYS=30
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_MINUTES=15
# A store left open longer than this is closed automatically, paying every
# attached shift's salary.
AUTO_CLOSE_HOURS=16
# GPS readings vaguer than this cannot tell neighbouring stores apart.
MAX_ACCURACY_M=100
# The hour a new store's trading day begins, so daily takings start again each
# morning rather than at midnight. Only the starting point: each store carries
# its own, editable under its settings.
DAY_START_HOUR=6
