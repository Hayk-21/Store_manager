# Copy to .env and fill in. On Railway these go in the bot service's Variables tab.

# From @BotFather. Also run /setprivacy -> Disable, so the bot can read the
# item names workers type.
BOT_TOKEN=

# The web service's bot API. On Railway use the private network (no egress cost):
#   http://web.railway.internal:8080/api/bot/v1
# Locally:
#   http://localhost:8000/api/bot/v1
API_BASE_URL=

# Must be the IDENTICAL string set on the web service.
BOT_SHARED_SECRET=

HTTP_TIMEOUT_S=10
HTTP_RETRIES=3
LOG_LEVEL=INFO

# Note what is NOT here: no store list, no coordinates, no radius, no store
# names. The server geofences from the database, so there is nothing to keep in
# sync between the two services.
